# Template de reverse proxy pro Radar OSC.
# Copie pra /etc/nginx/sites-available/validador-osc na EC2 e troque SEU_SUBDOMINIO.duckdns.org
# pelo subdomínio DuckDNS de verdade antes de ativar.
# O certbot reescreve este arquivo sozinho na etapa de HTTPS (passo 9 do docs/deploy_ec2.md);
# não precisa editar o bloco de certificado à mão.

server {
    listen 80;
    server_name SEU_SUBDOMINIO.duckdns.org;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
